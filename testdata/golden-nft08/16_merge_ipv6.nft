#!/usr/sbin/nft -f
# Generated by efw v1.6.0
# source: testdata/golden/16_merge_ipv6.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    set s_ipv6_cc0fc990 {
        type ipv6_addr
        flags interval
        elements = { 2001:db8::1, 2001:db8::2, 2001:db8::3 }
    }

    chain input {
        type filter hook input priority 0; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2001:db8::1 -> tcp *:80 }
        # 4: accept { 2001:db8::2 -> tcp *:80 }
        # 5: accept { 2001:db8::3 -> tcp *:80 }
        ip6 saddr @s_ipv6_cc0fc990 tcp dport 80 accept

        # 7: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2001:db8::1 -> tcp *:80 }
        # 4: accept { 2001:db8::2 -> tcp *:80 }
        # 5: accept { 2001:db8::3 -> tcp *:80 }
        ct status dnat ip6 saddr @s_ipv6_cc0fc990 meta l4proto tcp ct original proto-dst 80 accept

        # 7: drop { * }
        ct status dnat drop
    }
}
