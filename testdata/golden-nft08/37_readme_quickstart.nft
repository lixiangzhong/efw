#!/usr/sbin/nft -f
# Generated by efw v1.7.0
# source: testdata/golden/37_readme_quickstart.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    set s_svc_f27d64ea {
        type inet_service
        flags interval
        elements = { 80, 443 }
    }

    chain input {
        type filter hook input priority -99; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 5: tcp 1.1.4.0/24 -> 80
        # 6: tcp 1.1.4.0/24 -> 443
        ip saddr 1.1.4.0/24 tcp dport @s_svc_f27d64ea accept

        # 7: 2.2.2.2         -> 8080
        ip saddr 2.2.2.2 tcp dport 8080 accept
        ip saddr 2.2.2.2 udp dport 8080 accept

        # 8: icmp            *
        meta l4proto { icmp, ipv6-icmp } accept

        # 12: 3.3.3.3 -> 22 log
        ip saddr 3.3.3.3 tcp dport 22 log prefix "efw: " level info drop
        ip saddr 3.3.3.3 udp dport 22 log prefix "efw: " level info drop

        # 15: drop                     # 兜底：以上都不匹配的一律丢弃
        drop
    }

    chain forward {
        type filter hook forward priority -99; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 5: tcp 1.1.4.0/24 -> 80
        # 6: tcp 1.1.4.0/24 -> 443
        ct status dnat ip saddr 1.1.4.0/24 meta l4proto tcp ct original proto-dst @s_svc_f27d64ea accept

        # 7: 2.2.2.2         -> 8080
        ct status dnat ip saddr 2.2.2.2 meta l4proto tcp ct original proto-dst 8080 accept
        ct status dnat ip saddr 2.2.2.2 meta l4proto udp ct original proto-dst 8080 accept

        # 8: icmp            *
        ct status dnat meta l4proto { icmp, ipv6-icmp } accept

        # 12: 3.3.3.3 -> 22 log
        ct status dnat ip saddr 3.3.3.3 meta l4proto tcp ct original proto-dst 22 log prefix "efw: " level info drop
        ct status dnat ip saddr 3.3.3.3 meta l4proto udp ct original proto-dst 22 log prefix "efw: " level info drop

        # 15: drop                     # 兜底：以上都不匹配的一律丢弃
        ct status dnat drop
    }
}
