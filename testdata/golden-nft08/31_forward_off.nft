#!/usr/sbin/nft -f
# Generated by efw v1.8.0
# source: testdata/golden/31_forward_off.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: off

table inet efw {
    chain input {
        type filter hook input priority -99; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 5: 1.1.1.0/24 -> 22
        ip saddr 1.1.1.0/24 tcp dport 22 accept
        ip saddr 1.1.1.0/24 udp dport 22 accept

        # 8: drop { * }
        drop
    }
}
