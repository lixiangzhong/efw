#!/usr/sbin/nft -f
# Generated by efw v1.8.0
# source: testdata/golden/03_ports.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority -99; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        ip saddr 1.1.1.1 tcp dport 80 accept

        # 4: accept { 2.2.2.2 -> udp *:53-55 }
        ip saddr 2.2.2.2 udp dport { 53-55 } accept

        # 5: accept { 3.3.3.3 -> tcp *:{8080, 9090-9095} }
        ip saddr 3.3.3.3 tcp dport { 8080, 9090-9095 } accept

        # 7: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -99; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        ct status dnat ip saddr 1.1.1.1 meta l4proto tcp ct original proto-dst 80 accept

        # 4: accept { 2.2.2.2 -> udp *:53-55 }
        ct status dnat ip saddr 2.2.2.2 meta l4proto udp ct original proto-dst { 53-55 } accept

        # 5: accept { 3.3.3.3 -> tcp *:{8080, 9090-9095} }
        ct status dnat ip saddr 3.3.3.3 meta l4proto tcp ct original proto-dst 8080 accept
        ct status dnat ip saddr 3.3.3.3 meta l4proto tcp ct original proto-dst { 9090-9095 } accept

        # 7: drop { * }
        ct status dnat drop
    }
}
