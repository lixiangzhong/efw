#!/usr/sbin/nft -f
# Generated by efw v1.5.0
# source: testdata/golden/23_bare_ports_implicit.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    set s_svc_83e1a242 {
        type inet_service
        flags interval
        elements = { 80, 443, 8080, 9090 }
    }

    chain input {
        type filter hook input priority 0; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 4: 80 443
        # 5: 8080 9090
        tcp dport @s_svc_83e1a242 accept
        udp dport @s_svc_83e1a242 accept

        # 6: tcp 3306
        tcp dport 3306 accept

        # 9: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 4: 80 443
        # 5: 8080 9090
        ct status dnat meta l4proto tcp ct original proto-dst @s_svc_83e1a242 accept
        ct status dnat meta l4proto udp ct original proto-dst @s_svc_83e1a242 accept

        # 6: tcp 3306
        ct status dnat meta l4proto tcp ct original proto-dst 3306 accept

        # 9: drop { * }
        ct status dnat drop
    }
}
