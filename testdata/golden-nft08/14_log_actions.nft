#!/usr/sbin/nft -f
# Generated by efw v1.5.0
# source: testdata/golden/14_log_actions.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority 0; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2.2.2.2 -> tcp *:22 log }
        ip saddr 2.2.2.2 tcp dport 22 log prefix "efw: " level info accept

        # 4: reject { 3.3.3.3 -> tcp *:443 log }
        ip saddr 3.3.3.3 tcp dport 443 log prefix "efw: " level info reject

        # 6: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2.2.2.2 -> tcp *:22 log }
        ct status dnat ip saddr 2.2.2.2 meta l4proto tcp ct original proto-dst 22 log prefix "efw: " level info accept

        # 4: reject { 3.3.3.3 -> tcp *:443 log }
        ct status dnat ip saddr 3.3.3.3 meta l4proto tcp ct original proto-dst 443 log prefix "efw: " level info reject

        # 6: drop { * }
        ct status dnat drop
    }
}
