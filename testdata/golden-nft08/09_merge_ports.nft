#!/usr/sbin/nft -f
# Generated by efw v1.5.0
# source: testdata/golden/09_merge_ports.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    set s_svc_20551834 {
        type inet_service
        flags interval
        elements = { 80, 443, 8080-8090 }
    }

    chain input {
        type filter hook input priority 0; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        # 4: accept { 1.1.1.1 -> tcp *:443 }
        # 5: accept { 1.1.1.1 -> tcp *:8080-8090 }
        ip saddr 1.1.1.1 tcp dport @s_svc_20551834 accept

        # 7: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        # 4: accept { 1.1.1.1 -> tcp *:443 }
        # 5: accept { 1.1.1.1 -> tcp *:8080-8090 }
        ct status dnat ip saddr 1.1.1.1 meta l4proto tcp ct original proto-dst @s_svc_20551834 accept

        # 7: drop { * }
        ct status dnat drop
    }
}
