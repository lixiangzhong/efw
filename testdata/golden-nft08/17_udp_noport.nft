#!/usr/sbin/nft -f
# Generated by efw v1.7.0
# source: testdata/golden/17_udp_noport.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority -99; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> udp *:* }
        ip saddr 1.1.1.1 meta l4proto udp accept

        # 4: accept { 1.1.1.2 -> tcp *:* }
        ip saddr 1.1.1.2 meta l4proto tcp accept

        # 6: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -99; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> udp *:* }
        ct status dnat ip saddr 1.1.1.1 meta l4proto udp accept

        # 4: accept { 1.1.1.2 -> tcp *:* }
        ct status dnat ip saddr 1.1.1.2 meta l4proto tcp accept

        # 6: drop { * }
        ct status dnat drop
    }
}
