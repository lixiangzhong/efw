#!/usr/sbin/nft -f
# Generated by efw v1.5.0
# source: testdata/golden/08_merge_dst.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    set s_ipv4_0e5554dd {
        type ipv4_addr
        flags interval
        elements = { 1.1.1.1, 2.2.2.2 }
    }

    chain input {
        type filter hook input priority 0; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { * -> tcp 1.1.1.1:80 }
        # 4: accept { * -> tcp 2.2.2.2:80 }
        ip daddr @s_ipv4_0e5554dd tcp dport 80 accept

        # 6: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { * -> tcp 1.1.1.1:80 }
        # 4: accept { * -> tcp 2.2.2.2:80 }
        ct status dnat ct original ip daddr @s_ipv4_0e5554dd meta l4proto tcp ct original proto-dst 80 accept

        # 6: drop { * }
        ct status dnat drop
    }
}
