#!/usr/sbin/nft -f
# Generated by efw v1.1.0
# source: testdata/golden/33_iface.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: auto | forward: auto

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 本机回环放行（本机访问自身地址也走 lo）
        iifname "lo" accept

        # auto: 本机/CGNAT/link-local 来源放行（RFC1918 默认不放；Docker 网段按 apply 探测）
        ip saddr { 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16 } accept
        ip6 saddr { ::1, fc00::/7, fe80::/10 } accept

        # auto: 已建立连接放行
        ct state established,related accept

        # auto: IPv6 邻居发现（NDP）
        ip6 nexthdr ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept

        # auto: DHCPv6
        udp dport { 546, 547 } accept

        # 2: iface eth0
        iifname "eth0" accept

        # 3: iface eth1 log
        iifname "eth1" log prefix "efw: " level info accept

        # 6: drop
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如 Docker 发布端口）

        # auto: 本机/CGNAT/link-local 来源放行（RFC1918 默认不放；Docker 网段按 apply 探测）
        ip saddr { 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16 } accept
        ip6 saddr { ::1, fc00::/7, fe80::/10 } accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 2: iface eth0
        ct status dnat iifname "eth0" accept

        # 3: iface eth1 log
        ct status dnat iifname "eth1" log prefix "efw: " level info accept

        # 6: drop
        ct status dnat drop
    }
}
