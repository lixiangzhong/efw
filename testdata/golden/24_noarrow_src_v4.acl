v6-bootstrap off

# 纯源地址（无 -、无端口）
accept { 1.1.1.1 }
drop { 1.1.1.2 }
reject { 1.1.1.3 }

# 协议前缀
accept { tcp 1.1.1.4 }
accept { udp 1.1.1.5 }
accept { icmp 1.1.1.6 }

# 协议后缀
drop { 1.1.1.7 tcp }
drop { 1.1.1.8 udp }
reject { 1.1.1.9 icmp }

# CIDR 源
accept { 1.1.1.0/24 }
drop { tcp 1.1.2.0/24 }
reject { 1.1.3.0/24 udp }

# log 修饰
accept { 1.1.1.10 log }
drop { 1.1.1.11 tcp log }
reject { 1.1.1.12 log }

drop { * }
