#!/usr/sbin/nft -f
# Generated by efw v1.6.0
# source: testdata/golden/06_ipv6.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2001:db8::1 -> tcp [2001:db8::2]:443 }
        ip6 saddr 2001:db8::1 ip6 daddr 2001:db8::2 tcp dport 443 accept

        # 4: accept { 2001:db8::/32 -> udp *:53 }
        ip6 saddr 2001:db8::/32 udp dport 53 accept

        # 5: drop { * -> tcp [2001:db8::10]:22 }
        ip6 daddr 2001:db8::10 tcp dport 22 drop

        # 7: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 2001:db8::1 -> tcp [2001:db8::2]:443 }
        ct status dnat ip6 saddr 2001:db8::1 ct original ip6 daddr 2001:db8::2 meta l4proto tcp ct original proto-dst 443 accept

        # 4: accept { 2001:db8::/32 -> udp *:53 }
        ct status dnat ip6 saddr 2001:db8::/32 meta l4proto udp ct original proto-dst 53 accept

        # 5: drop { * -> tcp [2001:db8::10]:22 }
        ct status dnat ct original ip6 daddr 2001:db8::10 meta l4proto tcp ct original proto-dst 22 drop

        # 7: drop { * }
        ct status dnat drop
    }
}
