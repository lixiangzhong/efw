#!/usr/sbin/nft -f
# Generated by efw v1.7.0
# source: testdata/golden/11_default_allow.acl
# policy: accept | fallback: accept | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        ip saddr 1.1.1.1 tcp dport 80 accept

        # 4: drop { 3.3.3.3 -> *:22 }
        ip saddr 3.3.3.3 meta l4proto { tcp, udp } th dport 22 drop

        # 6: accept { * }
        accept
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> tcp *:80 }
        ct status dnat ip saddr 1.1.1.1 meta l4proto tcp ct original proto-dst 80 accept

        # 4: drop { 3.3.3.3 -> *:22 }
        ct status dnat ip saddr 3.3.3.3 meta l4proto tcp ct original proto-dst 22 drop
        ct status dnat ip saddr 3.3.3.3 meta l4proto udp ct original proto-dst 22 drop

        # 6: accept { * }
        ct status dnat accept
    }
}
