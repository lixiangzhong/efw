#!/usr/sbin/nft -f
# Generated by efw v1.0.0
# source: testdata/golden/03_ports.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: 1.1.1.1 -> tcp *:80 accept
        ip saddr 1.1.1.1 tcp dport 80 accept

        # 4: 2.2.2.2 -> udp *:53-55 accept
        ip saddr 2.2.2.2 udp dport { 53-55 } accept

        # 5: 3.3.3.3 -> tcp *:{8080, 9090-9095} accept
        ip saddr 3.3.3.3 tcp dport { 8080, 9090-9095 } accept

        # 7: drop
        drop
    }
}
