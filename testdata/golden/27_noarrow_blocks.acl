v6-bootstrap off

accept {
  1.1.1.1
  1.1.1.2 tcp
  tcp 1.1.1.3
  1.1.1.4 log
  udp 1.1.1.5 log
  1.1.1.0/24 icmp
  tcp 1.1.2.0/24
  1.1.1.6 accept
  2001:db8::1
  tcp 2001:db8::2
  * tcp
}

drop {
  2.2.2.2
  2.2.2.3 udp
  icmp 2.2.2.4
  2001:db8::/32
}

reject {
  3.3.3.3
  3.3.3.4 tcp
  icmp 3.3.3.0/24
}

accept { 4.4.4.4 }
drop { 5.5.5.5 }
reject { 6.6.6.6 }

drop { * }
