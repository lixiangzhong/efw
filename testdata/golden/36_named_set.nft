#!/usr/sbin/nft -f
# Generated by efw v1.7.0
# source: testdata/golden/36_named_set.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: auto | forward: auto

table inet efw {
    set ABC_v4 {
        type ipv4_addr
        flags interval
        elements = { 1.1.1.0/25 }
    }

    set ABC_v6 {
        type ipv6_addr
        flags interval
        elements = { 2001:db8::1 }
    }

    chain input {
        type filter hook input priority -99; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # auto: IPv6 基础设施（NDP / MLD / ICMPv6 错误，含 PMTUD）
        ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept

        # auto: DHCPv6
        udp dport { 546, 547 } accept

        # 9: @ABC -> 80 443
        ip saddr @ABC_v4 meta l4proto { tcp, udp } th dport { 80, 443 } accept
        ip6 saddr @ABC_v6 meta l4proto { tcp, udp } th dport { 80, 443 } accept

        # 10: @ABC tcp4 -> 22
        ip saddr @ABC_v4 meta nfproto ipv4 tcp dport 22 accept

        # 13: drop
        drop
    }

    chain forward {
        type filter hook forward priority -99; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 9: @ABC -> 80 443
        ct status dnat ip saddr @ABC_v4 meta l4proto tcp ct original proto-dst 80 accept
        ct status dnat ip saddr @ABC_v4 meta l4proto tcp ct original proto-dst 443 accept
        ct status dnat ip saddr @ABC_v4 meta l4proto udp ct original proto-dst 80 accept
        ct status dnat ip saddr @ABC_v4 meta l4proto udp ct original proto-dst 443 accept
        ct status dnat ip6 saddr @ABC_v6 meta l4proto tcp ct original proto-dst 80 accept
        ct status dnat ip6 saddr @ABC_v6 meta l4proto tcp ct original proto-dst 443 accept
        ct status dnat ip6 saddr @ABC_v6 meta l4proto udp ct original proto-dst 80 accept
        ct status dnat ip6 saddr @ABC_v6 meta l4proto udp ct original proto-dst 443 accept

        # 10: @ABC tcp4 -> 22
        ct status dnat ip saddr @ABC_v4 meta nfproto ipv4 meta l4proto tcp ct original proto-dst 22 accept

        # 13: drop
        ct status dnat drop
    }
}
