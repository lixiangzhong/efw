#!/usr/sbin/nft -f
# Generated by efw v1.0.0
# source: testdata/golden/13_bootstrap.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: auto

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 已建立连接放行
        ct state established,related accept

        # auto: IPv6 邻居发现（NDP）
        ip6 nexthdr ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept

        # auto: DHCPv6
        udp dport { 546, 547 } accept

        # 2: 1.1.1.1 -> tcp *:80 accept
        ip saddr 1.1.1.1 tcp dport 80 accept

        # 4: drop
        drop
    }
}
