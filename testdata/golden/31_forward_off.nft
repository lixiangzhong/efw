# Generated by efw v1.1.0
# source: testdata/golden/31_forward_off.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: off

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 本机/CGNAT/link-local 来源放行（RFC1918 默认不放；Docker 网段按 apply 探测）
        ip saddr { 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16 } accept
        ip6 saddr { ::1, fc00::/7, fe80::/10 } accept

        # auto: 已建立连接放行
