v6-bootstrap off

# 纯源地址（无 ->、无端口）
accept { 2001:db8::1 }
drop { 2001:db8::2 }
reject { 2001:db8::3 }

# 协议前缀
accept { tcp 2001:db8::4 }
accept { udp 2001:db8::5 }
accept { icmp 2001:db8::6 }

# 协议后缀
drop { 2001:db8::7 tcp }
drop { 2001:db8::8 udp }
reject { 2001:db8::9 icmp }

# CIDR 源
accept { 2001:db8::/32 }
drop { tcp 2001:db8:1::/48 }
reject { udp 2001:db8:2::/48 }

# log 修饰
accept { 2001:db8::10 log }
drop { 2001:db8::11 tcp log }
reject { 2001:db8::12 log }

drop { * }
