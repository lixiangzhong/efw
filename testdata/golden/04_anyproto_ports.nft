#!/usr/sbin/nft -f
# Generated by efw v1.6.0
# source: testdata/golden/04_anyproto_ports.acl
# policy: accept | fallback: drop | established: auto | v6-bootstrap: off | forward: auto

table inet efw {
    chain input {
        type filter hook input priority filter; policy accept;

        # auto: 本机回环放行（唯一的隐式信任：本机访问自身地址也走 lo；其余来源一律走 ACL）
        iifname "lo" accept

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> *:{80, 443} }
        ip saddr 1.1.1.1 meta l4proto { tcp, udp } th dport { 80, 443 } accept

        # 4: drop { * -> *:22 }
        meta l4proto { tcp, udp } th dport 22 drop

        # 6: drop { * }
        drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        # 说明: 本链只匹配 DNAT 转发流量（如容器发布端口）

        # auto: 已建立连接放行
        ct state established,related accept

        # 3: accept { 1.1.1.1 -> *:{80, 443} }
        ct status dnat ip saddr 1.1.1.1 meta l4proto tcp ct original proto-dst 80 accept
        ct status dnat ip saddr 1.1.1.1 meta l4proto tcp ct original proto-dst 443 accept
        ct status dnat ip saddr 1.1.1.1 meta l4proto udp ct original proto-dst 80 accept
        ct status dnat ip saddr 1.1.1.1 meta l4proto udp ct original proto-dst 443 accept

        # 4: drop { * -> *:22 }
        ct status dnat meta l4proto tcp ct original proto-dst 22 drop
        ct status dnat meta l4proto udp ct original proto-dst 22 drop

        # 6: drop { * }
        ct status dnat drop
    }
}
